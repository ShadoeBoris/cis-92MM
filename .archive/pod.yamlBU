apiVersion: v1
kind: Pod
metadata:
  labels:
    function: app
    version: v1
  name: django
spec:
  containers:
  - name: django
    image: ghcr.io/shadoeboris/cis-92mm:milestone-5.2
    ports:
    - containerPort: 8080
    resources:
      requests:
        cpu: 1000m
        ephemeral-storage: 10Mi
        memory: 512Mi
      limits:
        cpu: 1000m
        ephemeral-storage: 10Mi
        memory: 512Mi
  - env:
    - name: STUDENT_NAME
      value: "Boris Jocoy"
    - name: SITE_NAME
      value: "*"
    - name: SECRET_KEY
      value: "jfhajklfhadkuahfuaehwuhdf83839ufhdfhjk"  
    - name: DEBUG
      value: "1"
    - name: DATA_DIR
      value: "/data"
    - name: PORT
      value: "8080"
    - name: DJANGO_SUPERUSER_NAME
      value: "admin"
    - name: DJANGO_SUPERUSER_PASSWORD
      value: "password"
    - name: DJANGO_SUPERUSER_EMAIL 
      value: "admin@admin.com"

  envFrom:
  - configMapRef:
      name: mysite-config
  - secretRef:  
      name: mysite-secret
  volumeMounts:
  - mountPath: /data
    name: db
  volumes:
  - name: db
    persistentVolumeClaim:
      claimName: mysite-data
  securityContext:
    fsGroup: 1000

